    {
      "name": "04 SOAP (для сравнения с REST)",
      "item": [
        {
          "name": "WSDL",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type is XML\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/xml\"));",
                  "pm.test(\"Describes GetBook and ListBooks\", () => {",
                  "    pm.expect(pm.response.text()).to.include('operation name=\"GetBook\"');",
                  "    pm.expect(pm.response.text()).to.include('operation name=\"ListBooks\"');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/soap?wsdl",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "soap"
              ],
              "query": [
                {
                  "key": "wsdl",
                  "value": null
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "GetBook",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response is a SOAP envelope with a book\", () => {",
                  "    const xml = pm.response.text();",
                  "    pm.expect(xml).to.include(\"<soap:Envelope\");",
                  "    pm.expect(xml).to.match(/<tns:GetBookResponse><tns:book><tns:id>1<\\/tns:id>/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8"
              },
              {
                "key": "SOAPAction",
                "value": "\"http://example.com/library/GetBook\""
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/soap",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "soap"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\"\n               xmlns:tns=\"http://example.com/library\">\n  <soap:Body>\n    <tns:GetBookRequest><tns:id>1</tns:id></tns:GetBookRequest>\n  </soap:Body>\n</soap:Envelope>",
              "options": {
