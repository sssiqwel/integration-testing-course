{
  "info": {
    "name": "Library API — интеграционное тестирование",
    "description": "Учебная коллекция: CRUD для книг с цепочкой переменных, негативные сценарии и SOAP-вызовы. Запуск: make newman",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Выполняется после КАЖДОГО запроса коллекции.",
          "pm.test(\"Has X-Request-ID header\", () => pm.response.to.have.header(\"X-Request-ID\"));",
          "pm.test(\"Response time < 1000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(1000));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "bookId",
      "value": ""
    },
    {
      "key": "isbn",
      "value": ""
    },
    {
      "key": "initialCount",
      "value": ""
    }
