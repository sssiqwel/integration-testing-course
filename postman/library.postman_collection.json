    {
      "name": "02 CRUD flow (create -> read -> update -> delete)",
      "description": "Запросы выполняются по порядку и передают данные друг другу через переменные коллекции bookId и isbn.",
      "item": [
        {
          "name": "List books",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const bookList = { type: \"array\", items: {\"type\": \"object\", \"required\": [\"id\", \"title\", \"author\", \"year\", \"isbn\", \"available\"], \"additionalProperties\": false, \"properties\": {\"id\": {\"type\": \"integer\"}, \"title\": {\"type\": \"string\", \"minLength\": 1}, \"author\": {\"type\": \"string\", \"minLength\": 1}, \"year\": {\"type\": \"integer\"}, \"isbn\": {\"type\": [\"string\", \"null\"], \"pattern\": \"^97[89]\\\\d{10}$\"}, \"available\": {\"type\": \"boolean\"}}} };",
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Body is an array of books (JSON Schema)\", () => pm.response.to.have.jsonSchema(bookList));",
                  "pm.collectionVariables.set(\"initialCount\", pm.response.json().length);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "books"
              ]
            }
          }
        },
        {
          "name": "Create book",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Уникальный ISBN-13 на каждый прогон, чтобы не получить 409 Conflict.",
                  "let digits = \"\";",
                  "for (let i = 0; i < 10; i++) digits += Math.floor(Math.random() * 10);",
                  "pm.collectionVariables.set(\"isbn\", \"978\" + digits);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const bookSchema = {\"type\": \"object\", \"required\": [\"id\", \"title\", \"author\", \"year\", \"isbn\", \"available\"], \"additionalProperties\": false, \"properties\": {\"id\": {\"type\": \"integer\"}, \"title\": {\"type\": \"string\", \"minLength\": 1}, \"author\": {\"type\": \"string\", \"minLength\": 1}, \"year\": {\"type\": \"integer\"}, \"isbn\": {\"type\": [\"string\", \"null\"], \"pattern\": \"^97[89]\\\\d{10}$\"}, \"available\": {\"type\": \"boolean\"}}};",
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Location header points to the new book\", () => {",
                  "    pm.response.to.have.header(\"Location\");",
                  "    pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/v1/books/\" + pm.response.json().id);",
                  "});",
                  "pm.test(\"Body matches Book schema\", () => pm.response.to.have.jsonSchema(bookSchema));",
                  "pm.test(\"Body echoes sent data\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.title).to.eql(\"Тестирование API на практике\");",
                  "    pm.expect(body.isbn).to.eql(pm.collectionVariables.get(\"isbn\"));",
                  "});",
                  "pm.collectionVariables.set(\"bookId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "books"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Тестирование API на практике\",\n  \"author\": \"Иван Тестировщиков\",\n  \"year\": 2024,\n  \"isbn\": \"{{isbn}}\",\n  \"available\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get created book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Same id and isbn\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.id).to.eql(Number(pm.collectionVariables.get(\"bookId\")));",
