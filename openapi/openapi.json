{
  "openapi": "3.1.0",
  "info": {
    "title": "Library API",
    "description": "Учебный REST API библиотеки для курса «Интеграционное тестирование».\n\nЧтение (`GET`) доступно всем. Создание, изменение и удаление требуют заголовка `Authorization: Bearer <token>` — нажмите **Authorize** и введите `secret-token`.\n\nДля сравнения с SOAP есть эндпоинт `/soap` (WSDL: `GET /soap?wsdl`).",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "service"
        ],
        "summary": "Проверка, что сервер жив",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/books": {
      "get": {
        "tags": [
          "books"
        ],
        "summary": "Список книг",
        "operationId": "list_books_api_v1_books_get",
        "parameters": [
          {
            "name": "author",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Фильтр по части имени автора",
              "title": "Author"
            },
            "description": "Фильтр по части имени автора"
          },
          {
            "name": "available",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Фильтр по наличию",
              "title": "Available"
            },
            "description": "Фильтр по наличию"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Book"
                  },
                  "title": "Response List Books Api V1 Books Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "books"
        ],
        "summary": "Создать книгу",
        "operationId": "create_book_api_v1_books_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookIn"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "401": {
            "description": "Нет токена или токен неверный",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Книга с таким ISBN уже есть",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/books/{book_id}": {
      "get": {
        "tags": [
          "books"
        ],
        "summary": "Книга по id",
        "operationId": "get_book_api_v1_books__book_id__get",
        "parameters": [
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Book Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "404": {
            "description": "Книга не найдена",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "books"
        ],
        "summary": "Полностью заменить книгу",
        "operationId": "replace_book_api_v1_books__book_id__put",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Book Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "401": {
            "description": "Нет токена или токен неверный",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Книга не найдена",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Книга с таким ISBN уже есть",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "books"
        ],
        "summary": "Удалить книгу",
        "operationId": "delete_book_api_v1_books__book_id__delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Book Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Нет токена или токен неверный",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Книга не найдена",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Book": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "description": "Название книги"
          },
          "author": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Author",
            "description": "Автор"
          },
          "year": {
            "type": "integer",
            "minimum": 1450.0,
            "title": "Year",
            "description": "Год издания (не позже текущего)"
          },
          "isbn": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^97[89]\\d{10}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Isbn",
            "description": "ISBN-13 без дефисов, уникален в рамках библиотеки"
          },
          "available": {
            "type": "boolean",
            "title": "Available",
            "description": "Есть ли книга в наличии",
            "default": true
          },
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "Идентификатор, назначается сервером"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "author",
          "year",
          "id"
        ],
        "title": "Book",
        "examples": [
          {
            "author": "Михаил Булгаков",
            "available": true,
            "isbn": "9785170902765",
            "title": "Мастер и Маргарита",
            "year": 1967
          }
        ]
      },
      "BookIn": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "description": "Название книги"
          },
          "author": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Author",
            "description": "Автор"
          },
          "year": {
            "type": "integer",
            "minimum": 1450.0,
            "title": "Year",
            "description": "Год издания (не позже текущего)"
          },
          "isbn": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^97[89]\\d{10}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Isbn",
            "description": "ISBN-13 без дефисов, уникален в рамках библиотеки"
          },
          "available": {
            "type": "boolean",
            "title": "Available",
            "description": "Есть ли книга в наличии",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "author",
          "year"
        ],
        "title": "BookIn",
        "description": "Тело запроса для POST и PUT: все поля книги, кроме id.",
        "examples": [
          {
            "author": "Михаил Булгаков",
            "available": true,
            "isbn": "9785170902765",
            "title": "Мастер и Маргарита",
            "year": 1967
          }
        ]
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "Токен для изменяющих запросов. По умолчанию `secret-token` (переменная окружения API_TOKEN).",
        "scheme": "bearer"
      }
    }
  },
  "tags": [
    {
      "name": "books",
      "description": "CRUD для книг"
    },
    {
      "name": "service",
      "description": "Служебные эндпоинты"
    }
  ]
}
